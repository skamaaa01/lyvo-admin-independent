# Origin of the Lyvo API. The admin app calls /api/admin/*, /api/shadow/*, etc.
# In production this is whatever serves the backend, e.g. https://api.lyvo.app.
# Cookies on /api/admin/auth/login are scoped to this origin, so the API origin
# must share a parent domain with admin.lyvo.app for sessions to work in prod.
VITE_BACKEND_URL=http://localhost:8000
