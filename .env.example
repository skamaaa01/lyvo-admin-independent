# Origin of the Lyvo API. The admin app calls /api/admin/*, /api/shadow/*, etc.
# In production this is whatever serves the backend, e.g. https://api.lyvo.app.
# Cookies on /api/admin/auth/login are scoped to this origin, so the API origin
# must share a parent domain with admin.lyvo.app for sessions to work in prod.
VITE_BACKEND_URL=http://localhost:8000

# Origin of the customer-facing app. Used when an agent clicks "Shadow login"
# in Customer Support — the admin app builds a redirect like
# `<VITE_APP_BASE_URL>/?shadow_session=<id>` and opens it in a new tab.
# In production: https://lyvo.app
# In dev: leave blank to fall back to <current-host>:3000
VITE_APP_BASE_URL=http://localhost:3000
